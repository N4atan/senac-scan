// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String
}

enum EnumStatusBem {
  ATIVO
  AGUARDANDO_MANUTENCAO
  EM_MANUTENCAO
  PERDIDO
  BAIXADO
}

enum EnumEscolas {
  CENTRO
  UNISINOS
}

enum EnumCategoriaBem {
  ELETRONICOS
  MOVEIS
  EQUIPAMENTOS
  MATERIAL_ESCRITORIO
}

enum EnumStatusTransferencia {
  AGUARDANDO_SISPRO
  SISPRO_APROVADO
}

model bem_patrimonial {
  id                    Int              @id @default(autoincrement())
  codigo_patrimonial    String?          @unique
  descricao_bem         String
  identificacao_interna String
  categoria             EnumCategoriaBem
  id_local              Int?
  status                EnumStatusBem

  Local              sala?               @relation("bem_patrimonial", fields: [id_local], references: [id])
  logs_transferencia log_transferencia[] @relation("log_transferencia")
}

model sala {
  id        Int         @id @default(autoincrement())
  descricao String
  escola    EnumEscolas

  bens                   bem_patrimonial[]   @relation("bem_patrimonial")
  transferencias_destino log_transferencia[] @relation("log_transferencia_destino")
  transferencias_origem  log_transferencia[] @relation("log_transferencia_origem")
}

model log_transferencia {
  id                  Int                     @id @default(autoincrement())
  id_bem              Int
  id_local_destino    Int?
  id_local_origem     Int?
  data_transferencia  DateTime                @default(now())
  status_movimentacao EnumStatusTransferencia

  bem           bem_patrimonial @relation("log_transferencia", fields: [id_bem], references: [id])
  Local_destino sala?           @relation("log_transferencia_destino", fields: [id_local_destino], references: [id])
  Local_origem  sala?           @relation("log_transferencia_origem", fields: [id_local_origem], references: [id])
}
